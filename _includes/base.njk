<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or "Color, Calor, Y Sabor" }}{% if title %} — Color, Calor, Y Sabor{% endif %}</title>
<meta name="description" content="{{ description or 'A drop-in recipe box built on color, calor y sabor — markdown in, searchable recipe cards out.' }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;0,700;1,500&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
<link rel="icon" href="data:,">
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<div class="picado-strip" aria-hidden="true"></div>

<header class="site-header">
  <a class="wordmark" href="{{ '/' | url }}">Color, Calor, Y Sabor <span class="wordmark-sub">— recipe index</span></a>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  Drop a .md file in /recipes — it shows up here, color and all.
</footer>

<script>window.SITE_PATH_PREFIX = "{{ '/' | url }}";</script>
<script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0" defer></script>
<script src="{{ '/assets/search.js' | url }}" defer></script>
