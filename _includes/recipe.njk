---
layout: base.njk
---
<article class="recipe-page">
  <a class="back-link" href="{{ '/' | url }}">← Back to the box</a>

  <div class="tab-row tab-row--static">
    {% for cat in category | categoryList %}
    <span class="tab tab--{{ cat }}">{{ cat | capitalize }}</span>
    {% endfor %}
  </div>
  <h1>{{ title }}</h1>
  <div class="card-meta card-meta--detail">
    <span>{{ time }}</span>
    <span>Serves {{ serves }}</span>
  </div>

  {% if blurb %}<p class="blurb">{{ blurb }}</p>{% endif %}

  <div class="detail-section">
    <h2>Ingredients</h2>
    <ul>
      {% for group in ingredients | ingredientGroups %}
        {% if group.header %}
        <li class="ingredient-group">
          <strong>{{ group.header }}</strong>
          <ul>
            {% for item in group.items %}
            <li>{{ item | md | safe }}</li>
            {% endfor %}
          </ul>
        </li>
        {% else %}
          {% for item in group.items %}
          <li>{{ item | md | safe }}</li>
          {% endfor %}
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <div class="detail-section">
    <h2>Method</h2>
    {{ content | safe }}
  </div>

  {% set relatedItems = related | resolveRelated(collections.recipes) %}
  {% if relatedItems.length %}
  <div class="detail-section related-section">
    <h2>Pairs well with</h2>
    <div class="related-grid">
      {% for item in relatedItems %}
      <a class="related-card" href="{{ item.url | url }}">
        <span class="related-dot related-dot--{{ (item.data.category | categoryList)[0] }}"></span>
        {{ item.data.title }}
      </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if tags and tags.length %}
  <div class="tag-row">
    {% for t in tags %}<span class="tag">#{{ t }}</span>{% endfor %}
  </div>
  {% endif %}
</article>
